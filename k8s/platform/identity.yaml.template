apiVersion: v1
kind: ServiceAccount
metadata:
  name: portfolio-api
  namespace: portfolio
  annotations:
    azure.workload.identity/client-id: "${WORKLOAD_CLIENT_ID}"
automountServiceAccountToken: false
---
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: portfolio-keyvault
  namespace: portfolio
spec:
  provider: azure
  parameters:
    usePodIdentity: "false"
    clientID: "${WORKLOAD_CLIENT_ID}"
    keyvaultName: "${KEY_VAULT_NAME}"
    tenantId: "${AZURE_TENANT_ID}"
    objects: |
      array:
        - |
          objectName: demo-message
          objectType: secret
